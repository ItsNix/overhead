void handleSave() {
  if (server.hasArg("lat") && server.hasArg("lon")) {
    String la = server.arg("lat"), lo = server.arg("lon");
    la.trim(); lo.trim();
    double lat = la.toDouble(), lon = lo.toDouble();
    if (la.length() && lo.length() && lat >= -90 && lat <= 90 && lon >= -180 && lon <= 180) {
      if ((lat != settings.home_lat || lon != settings.home_lon) && cardShowing()) closeCard("home moved");
      settings.home_lat = lat;
      settings.home_lon = lon;
    }
  }
  if (server.hasArg("range")) settings.range_nm = nearestChoice(server.arg("range").toInt(), RANGE_CHOICES, RANGE_COUNT);
  settings.labels = server.hasArg("labels");
  settings.trails = server.hasArg("trails");
  if (server.hasArg("src"))  settings.source   = constrain(server.arg("src").toInt(), SRC_AUTO, SRC_ONLINE);
  if (server.hasArg("prov")) settings.provider = constrain(server.arg("prov").toInt(), PROV_AIRPLANES_LIVE, PROV_ADSB_LOL);
  if (server.hasArg("url"))  { settings.local_url = server.arg("url"); settings.local_url.trim(); }
  if (server.hasArg("poll")) settings.poll_s = constrain(server.arg("poll").toInt(), 1, 120);
  settings.poll_s = max(settings.poll_s, minPoll(settings.source));
  if (server.hasArg("ovmi")) settings.overhead_mi = nearestChoice(server.arg("ovmi").toInt(), OVERHEAD_CHOICES, OVERHEAD_COUNT);
  settings.show_card = server.hasArg("card");
  if (CrowPanel7::hasBuzzer()) settings.alert = server.hasArg("alert");
  if (server.hasArg("ntp")) settings.ntp_server = server.arg("ntp");
  if (server.hasArg("tz"))  settings.tz_string  = server.arg("tz");
  settings.format_24h = server.hasArg("fmt24");
  settings.color_clock  = server.hasArg("cclock");
  settings.show_seconds = server.hasArg("secs");
  settings.show_date    = server.hasArg("date");
  if (server.hasArg("gamma")) {
    settings.gamma = constrain(server.arg("gamma").toFloat(), MIN_GAMMA, MAX_GAMMA);
    buildGammaLut();
  }
  if (server.hasArg("bright")) settings.brightness = constrain(server.arg("bright").toInt(), 5, 100);
  int t;
  settings.dim_enabled = server.hasArg("dim");
  if ((t = parseHHMM(server.arg("dstart"))) >= 0) settings.dim_start = t;
  if ((t = parseHHMM(server.arg("dend")))   >= 0) settings.dim_end   = t;
  if (server.hasArg("dlevel")) settings.dim_level = constrain(server.arg("dlevel").toInt(), 5, 100);
  settings.off_enabled = server.hasArg("off");
  if ((t = parseHHMM(server.arg("ostart"))) >= 0) settings.off_start = t;
  if ((t = parseHHMM(server.arg("oend")))   >= 0) settings.off_end   = t;
  if (server.hasArg("wake")) settings.wake_s = constrain(server.arg("wake").toInt(), 5, 3600);
  saveSettings();
  rangeSaveAt = 0;
  applyTimeSettings();
  publishFetchConfig(true);
  radarDirty = true;
  logSettings("Saved");
  server.sendHeader("Location", "/");
  server.send(303);
}

void handleStatus() {
  JsonDocument doc;
  struct tm ti;
  doc["time"]   = getLocalTime(&ti, 20) ? formatTime(ti) : "--:--:--";
  doc["source"] = feed.source;
  doc["count"]  = viewCount;
  doc["total"]  = feed.total;
  doc["age"]    = feed.okAt ? (long)(msSince(feed.okAt) / 1000) : -1L;
  doc["error"]  = feed.error;
  doc["view"]   = cardShowing() ? "card" : clockShowing ? "clock" : "radar";
  if (viewCount) {
    const Aircraft& a = viewAc[0];
    doc["nearest"] = aircraftName(a) + " " + altString(a.alt) +
                     (a.alt > ALT_GROUND && a.alt < 18000 ? " ft, " : ", ") + nmString(a.dist_nm) +
                     " nm " + compass8(a.bearing);
  }
  String out;
  serializeJson(doc, out);
  server.send(200, "application/json", out);
}

// Diagnostic: the aircraft currently shown.
void handleAircraft() {
  JsonDocument doc;
  doc["source"] = feed.source;
  doc["age_s"]  = feed.okAt ? (long)(msSince(feed.okAt) / 1000) : -1L;
  JsonArray list = doc["aircraft"].to<JsonArray>();
  for (int i = 0; i < viewCount; i++) {
    const Aircraft& a = viewAc[i];
    JsonObject o = list.add<JsonObject>();
    o["hex"] = a.hex; o["flight"] = a.flight; o["type"] = a.type; o["reg"] = a.reg;
    o["lat"] = a.lat; o["lon"] = a.lon; o["alt"] = a.alt; o["gs"] = a.gs; o["track"] = a.track;
    o["rate"] = a.rate; o["squawk"] = a.squawk; o["cat"] = a.cat;
    o["dist_nm"] = serialized(String(a.dist_nm, 2)); o["bearing"] = (int)a.bearing;
  }
  String out;
  serializeJson(doc, out);
  server.send(200, "application/json", out);
}

