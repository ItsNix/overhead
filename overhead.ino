  String h = a.hex; h.toUpperCase(); return h;
}

// ── Geometry ────────────────────────────────────────────────────────────────
const double DEG = M_PI / 180.0;

float distanceNm(double lat1, double lon1, double lat2, double lon2) {
  double dlat = (lat2 - lat1) * DEG, dlon = (lon2 - lon1) * DEG;
  double a = sin(dlat / 2) * sin(dlat / 2) +
             cos(lat1 * DEG) * cos(lat2 * DEG) * sin(dlon / 2) * sin(dlon / 2);
  return (float)(2 * atan2(sqrt(a), sqrt(1 - a)) * 3440.065);   // Earth radius in nm
}

float bearingDeg(double lat1, double lon1, double lat2, double lon2) {
  double dlon = (lon2 - lon1) * DEG;
  double y = sin(dlon) * cos(lat2 * DEG);
  double x = cos(lat1 * DEG) * sin(lat2 * DEG) - sin(lat1 * DEG) * cos(lat2 * DEG) * cos(dlon);
  double b = atan2(y, x) / DEG;
  return (float)(b < 0 ? b + 360 : b);
}

// Where the aircraft is probably now: last position moved along its track at
// its ground speed (not on the ground; at most MAX_EXTRAP_S).
void extrapolate(const Aircraft& a, uint32_t now, double& lat, double& lon) {
  lat = a.lat; lon = a.lon;
  if (a.gs <= 0 || a.track < 0 || a.alt == ALT_GROUND) return;
  float dt = (now - a.fetched) / 1000.0f + a.seen_pos;
  if (dt > MAX_EXTRAP_S) dt = MAX_EXTRAP_S;
  double d = a.gs * dt / 3600.0;   // nm
  lat += d * cos(a.track * DEG) / 60.0;
  lon += d * sin(a.track * DEG) / (60.0 * cos(lat * DEG));
}

// Flat projection around home (fine at these ranges), north up.
float radarScale() { return (float)RADAR_R / settings.range_nm; }   // px per nm

void project(double lat, double lon, float& x, float& y) {
  float s = radarScale();
  x = RADAR_CX + (float)((lon - settings.home_lon) * 60.0 * cos(settings.home_lat * DEG)) * s;
  y = RADAR_CY - (float)((lat - settings.home_lat) * 60.0) * s;
}

bool insideRadar(float x, float y, float margin = 0) {
  float dx = x - RADAR_CX, dy = y - RADAR_CY, r = RADAR_R - margin;
  return dx * dx + dy * dy <= r * r;
}

// ── Aircraft feed (fetch task on core 0) ────────────────────────────────────
// The task fills its own buffer, then publishes it under dataMutex; loop()
// copies it out when feedVersion changes.
SemaphoreHandle_t dataMutex;
TaskHandle_t      fetchTaskHandle = nullptr;
FetchConfig       fetchCfg;               // guarded by dataMutex

struct FeedStatus {
  uint32_t version = 0;   // bumped on every attempt
  uint32_t okAt = 0;      // millis() of the last successful fetch; 0 = never
  int      count = 0;     // aircraft within range (kept, up to MAX_AIRCRAFT)
  int      total = 0;     // aircraft in the response
  char     source[20] = "";
  char     error[64] = "";
};
FeedStatus feedShared;                    // guarded by dataMutex
Aircraft*  feedAc = nullptr;              // guarded by dataMutex

// What loop() draws from.
FeedStatus feed;
Aircraft*  viewAc = nullptr;
int        viewCount = 0;

struct PsramAllocator : ArduinoJson::Allocator {
  void* allocate(size_t n) override { return heap_caps_malloc(n, MALLOC_CAP_SPIRAM); }
  void deallocate(void* p) override { heap_caps_free(p); }
  void* reallocate(void* p, size_t n) override { return heap_caps_realloc(p, n, MALLOC_CAP_SPIRAM); }
} psramAllocator;

void publishFetchConfig(bool fetchNow) {
  xSemaphoreTake(dataMutex, portMAX_DELAY);
  fetchCfg.lat      = settings.home_lat;
  fetchCfg.lon      = settings.home_lon;
  fetchCfg.home_set = homeSet();
  fetchCfg.range_nm = settings.range_nm;
  fetchCfg.source   = settings.source;
  fetchCfg.provider = settings.provider;
  fetchCfg.poll_s   = settings.poll_s;
  strlcpy(fetchCfg.local_url, settings.local_url.c_str(), sizeof(fetchCfg.local_url));
  xSemaphoreGive(dataMutex);
  if (fetchNow && fetchTaskHandle) xTaskNotifyGive(fetchTaskHandle);
}

// "192.168.1.50" → "http://192.168.1.50/data/aircraft.json"; full URLs are kept.
String localFeedUrl(const char* in) {
  String u = in;
  u.trim();
  if (u.indexOf("://") < 0) u = "http://" + u;
  if (u.indexOf(".json") < 0) {
    while (u.endsWith("/")) u.remove(u.length() - 1);
    u += "/data/aircraft.json";
  }
  return u;
}

String onlineFeedUrl(const FetchConfig& cfg) {
  // Ask a little past the radar edge so aircraft entering are already known.
  int radius = min(250, (int)ceilf(cfg.range_nm * 1.2f) + 1);
  char url[128];
  snprintf(url, sizeof(url), "https://%s/v2/point/%.4f/%.4f/%d",
           cfg.provider == PROV_ADSB_LOL ? "api.adsb.lol" : "api.airplanes.live",
           cfg.lat, cfg.lon, radius);
  return url;
}

// Only the fields we use are kept while parsing, so large feeds stay small.
JsonDocument& feedFilter() {
  static JsonDocument filter;
  if (filter.isNull()) {
    filter["now"] = true;
    for (const char* list : {"ac", "aircraft"}) {
      JsonObject f = filter[list].add<JsonObject>();
      for (const char* k : {"hex", "flight", "t", "r", "squawk", "category", "lat", "lon",
                            "alt_baro", "alt_geom", "gs", "track", "true_heading",
                            "baro_rate", "geom_rate", "seen_pos"}) {
        f[k] = true;
      }
    }
  }
  return filter;
}

void copyTrimmed(char* dst, size_t n, const char* src) {
  strlcpy(dst, src ? src : "", n);
  for (int i = strlen(dst) - 1; i >= 0 && dst[i] == ' '; i--) dst[i] = 0;
}

int cmpDist(const void* a, const void* b) {
  float d = ((const Aircraft*)a)->dist_nm - ((const Aircraft*)b)->dist_nm;
  return d < 0 ? -1 : d > 0 ? 1 : 0;
}

#define MAX_BODY_BYTES (3 * 1024 * 1024)

// Reads the whole response body into a PSRAM buffer (caller frees). Reading the
// TLS socket directly from the parser hit "no data yet" mid-body and stopped.
// Chunked bodies are decoded in place.
uint8_t* readBody(HTTPClient& http, size_t& len, String& err) {
  NetworkClient* in = http.getStreamPtr();
  int expected = http.getSize();                 // -1 when chunked / unknown
  bool chunked = http.header("Transfer-Encoding").equalsIgnoreCase("chunked");
  size_t cap = expected > 0 ? expected + 1 : 64 * 1024;
  if (cap > MAX_BODY_BYTES) { err = "response too large"; return nullptr; }
  uint8_t* buf = (uint8_t*)heap_caps_malloc(cap, MALLOC_CAP_SPIRAM);
  len = 0;
  uint32_t last = millis();
  while (buf && (expected < 0 || (int)len < expected)) {
    int avail = in->available();
    if (avail <= 0) {
      if (!in->connected()) break;
      if (millis() - last > 8000) { err = "read timeout"; heap_caps_free(buf); return nullptr; }
      delay(5);
      continue;
    }
    if (len + avail > cap) {
      size_t ncap = max(cap * 2, len + avail);
      if (ncap > MAX_BODY_BYTES) { err = "response too large"; heap_caps_free(buf); return nullptr; }
      uint8_t* nb = (uint8_t*)heap_caps_realloc(buf, ncap, MALLOC_CAP_SPIRAM);
      if (!nb) break;
      buf = nb; cap = ncap;
    }
    int n = in->read(buf + len, avail);
    if (n > 0) { len += n; last = millis(); }
    // A kept-alive connection never closes, so stop at the last (empty) chunk.
    if (chunked && len >= 5 && !memcmp(buf + len - 5, "0\r\n\r\n", 5)) break;
  }
  if (!buf) { err = "out of memory"; return nullptr; }
  if (expected > 0 && (int)len < expected) { err = "short read"; heap_caps_free(buf); return nullptr; }

  if (chunked) {
    size_t r = 0, w = 0;
    while (r < len) {
      size_t size = strtoul((const char*)buf + r, nullptr, 16);
      while (r < len && buf[r] != '\n') r++;
      r++;                                       // past the size line
      if (size == 0 || r + size > len) break;
      memmove(buf + w, buf + r, size);
      w += size; r += size + 2;                  // data, then CRLF
    }
    len = w;
  }
  return buf;
}

// GETs url and returns the body in PSRAM (caller frees with heap_caps_free),
// or nullptr with err set.
uint8_t* httpGet(const String& url, size_t& len, String& err) {
  bool https = url.startsWith("https://");
  WiFiClient plain;
  WiFiClientSecure tls;
  // No certificate check: the feeds are public, read-only data.
  if (https) tls.setInsecure();
  HTTPClient http;
  const char* keep[] = {"Transfer-Encoding"};
  http.collectHeaders(keep, 1);
  http.setConnectTimeout(4000);
  http.setTimeout(8000);
  http.setUserAgent(USER_AGENT);
  http.setReuse(false);          // "Connection: close", so the server ends the body by closing
  if (!(https ? http.begin(tls, url) : http.begin(plain, url))) { err = "bad URL"; return nullptr; }
  int code = http.GET();
  if (code != HTTP_CODE_OK) {
    err = code < 0 ? HTTPClient::errorToString(code) : "HTTP " + String(code);
    http.end();
    return nullptr;
  }
  uint8_t* body = readBody(http, len, err);
  http.end();
  return body;
}

// GETs a readsb-style JSON feed ("ac" or "aircraft" array) and keeps the
// nearest MAX_AIRCRAFT with a recent position within range, sorted by distance.
bool fetchFeed(const String& url, const FetchConfig& cfg, Aircraft* out, int& count, int& total,
               String& err) {
  count = total = 0;
  size_t len;
  uint8_t* body = httpGet(url, len, err);
  if (!body) return false;
  JsonDocument doc(&psramAllocator);
  DeserializationError e = deserializeJson(doc, (const char*)body, len,
                                           DeserializationOption::Filter(feedFilter()));
  heap_caps_free(body);
  if (e) { err = String("JSON: ") + e.c_str(); return false; }

  JsonArray list = doc["ac"].as<JsonArray>();
  if (list.isNull()) list = doc["aircraft"].as<JsonArray>();
  if (list.isNull() && doc["now"].isNull()) { err = "not an aircraft feed"; return false; }

  uint32_t now = millis();
  float maxDist = cfg.range_nm * 1.2f + 1;
  for (JsonObject a : list) {
    total++;
    if (!a["lat"].is<double>() || !a["lon"].is<double>()) continue;
    float seen = a["seen_pos"] | 0.0f;
    if (seen > 60) continue;
    Aircraft x = {};
    x.lat = a["lat"]; x.lon = a["lon"];
    x.dist_nm = distanceNm(cfg.lat, cfg.lon, x.lat, x.lon);
    if (x.dist_nm > maxDist) continue;
    x.bearing = bearingDeg(cfg.lat, cfg.lon, x.lat, x.lon);
    x.seen_pos = seen;
    x.fetched = now;
    copyTrimmed(x.hex,    sizeof(x.hex),    a["hex"]);
    copyTrimmed(x.flight, sizeof(x.flight), a["flight"]);
    copyTrimmed(x.type,   sizeof(x.type),   a["t"]);
    copyTrimmed(x.reg,    sizeof(x.reg),    a["r"]);
    copyTrimmed(x.squawk, sizeof(x.squawk), a["squawk"]);
    copyTrimmed(x.cat,    sizeof(x.cat),    a["category"]);
    JsonVariant ab = a["alt_baro"];
    if (ab.is<int>())                                                x.alt = ab;
    else if (ab.is<const char*>() && !strcmp(ab.as<const char*>(), "ground")) x.alt = ALT_GROUND;
    else if (a["alt_geom"].is<int>())                                x.alt = a["alt_geom"];
    else                                                             x.alt = ALT_UNKNOWN;
    x.gs    = a["gs"].is<float>() ? (int16_t)lroundf(a["gs"].as<float>()) : -1;
    x.track = a["track"].is<float>()        ? (int16_t)lroundf(a["track"].as<float>()) % 360
            : a["true_heading"].is<float>() ? (int16_t)lroundf(a["true_heading"].as<float>()) % 360
            : -1;
    x.rate  = a["baro_rate"].is<int>() ? a["baro_rate"].as<int>() : a["geom_rate"] | 0;

    if (count < MAX_AIRCRAFT) {
      out[count++] = x;
    } else {   // full: replace the farthest if this one is nearer
      int far = 0;
      for (int i = 1; i < count; i++) if (out[i].dist_nm > out[far].dist_nm) far = i;
      if (x.dist_nm < out[far].dist_nm) out[far] = x;
    }
  }
  qsort(out, count, sizeof(Aircraft), cmpDist);
  return true;
}

// ── Overhead card lookups (fetch task) ─────────────────────────────────────
CardRequest cardReq = {};                 // guarded by dataMutex
CardInfo    cardShared = {};              // guarded by dataMutex; its jpg belongs to the task
uint32_t    cardVersion = 0;              // guarded by dataMutex

#define MAX_PHOTO_BYTES (400 * 1024)

JsonDocument* getJson(const String& url, String& err) {
  size_t len;
  uint8_t* body = httpGet(url, len, err);
  if (!body) return nullptr;
  JsonDocument* doc = new JsonDocument(&psramAllocator);
  DeserializationError e = deserializeJson(*doc, (const char*)body, len);
  heap_caps_free(body);
  if (e) { err = String("JSON: ") + e.c_str(); delete doc; return nullptr; }
  return doc;
}

void airportFields(JsonObject ap, char* code, size_t codeLen, char* city, size_t cityLen) {
  const char* iata = ap["iata"] | "";
  strlcpy(code, *iata ? iata : (ap["icao"] | ""), codeLen);
  const char* loc = ap["location"] | "";
  strlcpy(city, *loc ? loc : (ap["name"] | ""), cityLen);
}

// adsb.lol's route database, by callsign. Multi-stop routes ("JAC-DEN-CVG")
// pick the leg the aircraft is on: the one it adds the least distance to.
void lookupRoute(const CardRequest& r, CardInfo& c) {
  String cs = r.callsign;
  if (cs.length() < 3) return;
  String err;
  JsonDocument* doc = getJson("https://vrs-standing-data.adsb.lol/routes/" + cs.substring(0, 2) + "/" +
                              cs + ".json", err);
  if (!doc) { Serial.printf("Route %s: %s\n", r.callsign, err.c_str()); return; }
  JsonArray aps = (*doc)["_airports"];
  int n = aps.size(), best = -1;
  float bestCost = 1e9;
  for (int i = 0; i + 1 < n; i++) {
    double la0 = aps[i]["lat"], lo0 = aps[i]["lon"], la1 = aps[i + 1]["lat"], lo1 = aps[i + 1]["lon"];
    float cost = distanceNm(la0, lo0, r.lat, r.lon) + distanceNm(r.lat, r.lon, la1, lo1) -
                 distanceNm(la0, lo0, la1, lo1);
    if (cost < bestCost) { bestCost = cost; best = i; }
  }
  // The route database can be stale (callsigns get reused): ignore a route
  // the aircraft is well off.
  if (best >= 0) {
    double la0 = aps[best]["lat"], lo0 = aps[best]["lon"], la1 = aps[best + 1]["lat"], lo1 = aps[best + 1]["lon"];
    float leg = distanceNm(la0, lo0, la1, lo1);
    if (bestCost > max(60.0f, leg * 0.3f)) {
      Serial.printf("Route %s: %s ignored, %.0f nm off it\n", r.callsign, (*doc)["_airport_codes_iata"] | "?", bestCost);
      best = -1;
    }
  }
  if (best >= 0) {
    airportFields(aps[best],     c.from_code, sizeof(c.from_code), c.from_city, sizeof(c.from_city));
    airportFields(aps[best + 1], c.to_code,   sizeof(c.to_code),   c.to_city,   sizeof(c.to_city));
  }
  delete doc;
}

// hexdb.io: manufacturer, model and registered owner by ICAO address.
void lookupAircraft(const String& hex, CardInfo& c) {
  String err;
  JsonDocument* doc = getJson("https://hexdb.io/api/v1/aircraft/" + hex, err);
  if (!doc) { Serial.printf("Aircraft %s: %s\n", hex.c_str(), err.c_str()); return; }
  String maker = (*doc)["Manufacturer"] | "", type = (*doc)["Type"] | "";
  String model = type.startsWith(maker) ? type : maker + " " + type;
  model.trim();
  strlcpy(c.model, model.c_str(), sizeof(c.model));
  strlcpy(c.owner, (*doc)["RegisteredOwners"] | "", sizeof(c.owner));
  delete doc;
}

// planespotters.net: the first photo's 420x280 thumbnail and its photographer.
void lookupPhoto(const String& hex, CardInfo& c) {
  String err;
  JsonDocument* doc = getJson("https://api.planespotters.net/pub/photos/hex/" + hex, err);
  if (!doc) { Serial.printf("Photo %s: %s\n", hex.c_str(), err.c_str()); return; }
  JsonObject photo = (*doc)["photos"][0];
  String src = photo["thumbnail_large"]["src"] | "";
  strlcpy(c.photographer, photo["photographer"] | "", sizeof(c.photographer));
  delete doc;
  if (!src.length()) return;
  // planespotters serves progressive JPEGs, which LovyanGFX's decoder (TJpgDec)
  // can't read; images.weserv.nl re-encodes them as baseline. Direct as fallback.
  String proxied = src;
  proxied.replace("https://", "");
  proxied = "https://images.weserv.nl/?url=" + proxied + "&w=420&h=280&fit=cover&output=jpg&q=85";
  size_t len;
  uint8_t* jpg = httpGet(proxied, len, err);
  if (!jpg) {
    Serial.printf("Photo proxy: %s\n", err.c_str());
    jpg = httpGet(src, len, err);
  }
  if (!jpg) { Serial.printf("Photo %s: %s\n", hex.c_str(), err.c_str()); return; }
  if (len > MAX_PHOTO_BYTES) { heap_caps_free(jpg); return; }
  c.jpg = jpg;
  c.jpg_len = len;
}

// Runs the lookups for a new card request, if there is one.
void serviceCardRequest() {
  CardRequest r;
  xSemaphoreTake(dataMutex, portMAX_DELAY);
  r = cardReq;
  bool need = r.hex[0] && strcmp(r.hex, cardShared.hex) != 0;
  xSemaphoreGive(dataMutex);
  if (!need || WiFi.status() != WL_CONNECTED) return;

  uint32_t start = millis();
  CardInfo c = {};
  strlcpy(c.hex, r.hex, sizeof(c.hex));
  String hex = r.hex;
  hex.toUpperCase();
  lookupRoute(r, c);
  lookupAircraft(hex, c);
  lookupPhoto(hex, c);
  c.done = true;
  Serial.printf("Card %s: %s-%s, %s, %s, photo %u bytes (%lu ms)\n", r.callsign, c.from_code, c.to_code,
                c.model, c.owner, (unsigned)c.jpg_len, (unsigned long)(millis() - start));

  xSemaphoreTake(dataMutex, portMAX_DELAY);
  if (cardShared.jpg) heap_caps_free(cardShared.jpg);
  cardShared = c;
  cardVersion++;
  xSemaphoreGive(dataMutex);
}

void fetchTask(void*) {
  Aircraft* work = (Aircraft*)heap_caps_malloc(sizeof(Aircraft) * MAX_AIRCRAFT, MALLOC_CAP_SPIRAM);
  for (;;) {
    serviceCardRequest();
    FetchConfig cfg;
    xSemaphoreTake(dataMutex, portMAX_DELAY);
    cfg = fetchCfg;
    xSemaphoreGive(dataMutex);

    if (cfg.home_set && WiFi.status() == WL_CONNECTED) {
      int count = 0, total = 0;
      String err, src;
      bool ok = false;
      bool haveLocal = cfg.local_url[0] != 0;
      if (cfg.source != SRC_ONLINE && haveLocal) {
        src = "receiver";
        ok = fetchFeed(localFeedUrl(cfg.local_url), cfg, work, count, total, err);
        if (!ok) err = "receiver: " + err;
      }
      if (cfg.source == SRC_LOCAL && !haveLocal) err = "no receiver URL set";
      if (!ok && cfg.source != SRC_LOCAL) {
        String localErr = err;
        src = PROVIDER_NAMES[cfg.provider];
        ok = fetchFeed(onlineFeedUrl(cfg), cfg, work, count, total, err);
        if (ok && localErr.length()) err = localErr;   // fell back: keep the reason visible
        else if (!ok) err = src + ": " + err;
      }
      if (ok) Serial.printf("Feed: %s, %d of %d aircraft in range%s%s\n", src.c_str(), count, total,
                            err.length() ? "; " : "", err.c_str());
      else    Serial.printf("Feed failed: %s\n", err.c_str());

      xSemaphoreTake(dataMutex, portMAX_DELAY);
      feedShared.version++;
      if (ok) {
        memcpy(feedAc, work, sizeof(Aircraft) * count);
        feedShared.count = count;
        feedShared.total = total;
        feedShared.okAt  = millis() | 1;
        strlcpy(feedShared.source, src.c_str(), sizeof(feedShared.source));
      }
      strlcpy(feedShared.error, err.c_str(), sizeof(feedShared.error));
      xSemaphoreGive(dataMutex);
    }
    // Sleep until the next poll, or until settings change.
    ulTaskNotifyTake(pdTRUE, pdMS_TO_TICKS(max<uint16_t>(cfg.poll_s, 1) * 1000UL));
  }
}

void startFetchTask() {
  dataMutex = xSemaphoreCreateMutex();
  feedAc = (Aircraft*)heap_caps_calloc(MAX_AIRCRAFT, sizeof(Aircraft), MALLOC_CAP_SPIRAM);
  viewAc = (Aircraft*)heap_caps_calloc(MAX_AIRCRAFT, sizeof(Aircraft), MALLOC_CAP_SPIRAM);
  publishFetchConfig(false);
  // TLS handshakes need a deep stack; core 0 is where WiFi runs anyway.
  xTaskCreatePinnedToCore(fetchTask, "fetch", 20 * 1024, nullptr, 1, &fetchTaskHandle, 0);
}

// Copies a new feed result into the view; true if there was one.
bool pullFeed() {
  bool fresh = false;
  xSemaphoreTake(dataMutex, portMAX_DELAY);
  if (feedShared.version != feed.version) {
    fresh = feedShared.okAt != feed.okAt;
    feed = feedShared;
    if (fresh) {
      memcpy(viewAc, feedAc, sizeof(Aircraft) * feedShared.count);
      viewCount = feedShared.count;
    }
  }
  xSemaphoreGive(dataMutex);
  return fresh;
}

// ── Trails ──────────────────────────────────────────────────────────────────
Trail* trails = nullptr;          // MAX_TRAILS, PSRAM

Trail* findTrail(const char* hex) {
  for (int i = 0; i < MAX_TRAILS; i++) if (trails[i].hex[0] && !strcmp(trails[i].hex, hex)) return &trails[i];
  return nullptr;
}

void updateTrails() {
  uint32_t now = millis();
  for (int i = 0; i < viewCount; i++) {
    const Aircraft& a = viewAc[i];
    Trail* t = findTrail(a.hex);
    if (!t) {
      for (int j = 0; j < MAX_TRAILS && !t; j++) if (!trails[j].hex[0]) t = &trails[j];
      if (!t) continue;
      memset(t, 0, sizeof(Trail));
      strlcpy(t->hex, a.hex, sizeof(t->hex));
    }
    t->lastSeen = now;
    if (t->n) {
      int last = (t->head + TRAIL_POINTS - 1) % TRAIL_POINTS;
      if (distanceNm(t->lat[last], t->lon[last], a.lat, a.lon) < TRAIL_MIN_NM) continue;
    }
    t->lat[t->head] = a.lat;
    t->lon[t->head] = a.lon;
    t->head = (t->head + 1) % TRAIL_POINTS;
    if (t->n < TRAIL_POINTS) t->n++;
  }
  for (int j = 0; j < MAX_TRAILS; j++) {
    if (trails[j].hex[0] && now - trails[j].lastSeen > TRAIL_EXPIRE_MS) trails[j].hex[0] = 0;
  }
}

// ── Status / boot screens ───────────────────────────────────────────────────
void drawStatus(const String& l1, const String& l2, uint16_t color) {
  spr.fillSprite(TFT_BLACK);
  spr.setTextDatum(MC_DATUM);
  spr.setTextColor(color, TFT_BLACK);
  useFont(font56);
  if (l2.length() == 0) {
    spr.drawString(l1, SCREEN_W/2, SCREEN_H/2);
  } else {
    spr.drawString(l1, SCREEN_W/2, SCREEN_H/2 - 40);
    useFont(font40);
    spr.setTextColor(TFT_WHITE, TFT_BLACK);
    spr.drawString(l2, SCREEN_W/2, SCREEN_H/2 + 40);
  }
}

void showStatus(const String& l1, const String& l2 = "", uint16_t color = TFT_CYAN) {
  drawStatus(l1, l2, color);
  presentFrame();
}

void portalCallback(WiFiManager* wm) {
  spr.fillSprite(TFT_BLUE);
  spr.setTextDatum(MC_DATUM);
  spr.setTextColor(TFT_WHITE, TFT_BLUE);
  useFont(font56);
