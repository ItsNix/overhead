  useFont(font40);
  spr.drawString("Connect phone to:", SCREEN_W/2, 140);
  useFont(font56);
  spr.setTextColor(TFT_YELLOW, TFT_BLUE);
  spr.drawString(AP_NAME, SCREEN_W/2, 215);
  useFont(font40);
