// ms since a millis() timestamp. Timestamps stored as "millis() | 1" (so 0
// can mean "never") may be 1 ms in the future; that reads as 0, not ~49 days.
uint32_t msSince(uint32_t t) {
  int32_t d = (int32_t)(millis() - t);
  return d < 0 ? 0 : d;
}

bool homeSet() { return settings.home_lat != 0 || settings.home_lon != 0; }

// Smallest poll interval: local receivers are cheap; be polite to the free APIs.
uint16_t minPoll(uint8_t source) { return source == SRC_LOCAL ? 1 : 5; }

uint16_t nearestChoice(uint16_t v, const uint16_t* choices, uint8_t n) {
  for (int i = 0; i < n; i++) if (choices[i] >= v) return choices[i];
  return choices[n - 1];
}

void loadSettings() {
  prefs.begin("overhead", true);
  settings.ntp_server   = prefs.getString("ntp",   DEFAULT_NTP);
  settings.tz_string    = prefs.getString("tz",    DEFAULT_TZ);
  settings.format_24h   = prefs.getBool  ("fmt24", true);
  settings.color_clock  = prefs.getBool  ("cclock", true);
  settings.show_seconds = prefs.getBool  ("secs",  true);
  settings.show_date    = prefs.getBool  ("date",  true);
  settings.gamma        = constrain(prefs.getFloat("gamma", DEFAULT_GAMMA), MIN_GAMMA, MAX_GAMMA);
  settings.brightness   = prefs.getUChar ("bright", 100);
  settings.dim_enabled  = prefs.getBool  ("dim",    false);
  settings.dim_start    = prefs.getUShort("dstart", 20 * 60);
  settings.dim_end      = prefs.getUShort("dend",   22 * 60);
  settings.dim_level    = prefs.getUChar ("dlevel", 30);
  settings.off_enabled  = prefs.getBool  ("off",    false);
  settings.off_start    = prefs.getUShort("ostart", 22 * 60);
  settings.off_end      = prefs.getUShort("oend",   7 * 60);
  settings.wake_s       = prefs.getUShort("wake",   30);
  settings.home_lat     = prefs.getDouble("lat",    DEFAULT_LAT);
  settings.home_lon     = prefs.getDouble("lon",    DEFAULT_LON);
  settings.range_nm     = nearestChoice(prefs.getUShort("range", 25), RANGE_CHOICES, RANGE_COUNT);
  settings.source       = min<uint8_t>(prefs.getUChar("src", SRC_AUTO), SRC_ONLINE);
  settings.provider     = min<uint8_t>(prefs.getUChar("prov", PROV_ADSB_LOL), PROV_ADSB_LOL);
  settings.local_url    = prefs.getString("url",    "");
  settings.poll_s       = max(prefs.getUShort("poll", 5), minPoll(settings.source));
  settings.labels       = prefs.getBool  ("labels", true);
  settings.trails       = prefs.getBool  ("trails", true);
  settings.alert        = prefs.getBool  ("alert",  false);
  settings.overhead_mi  = nearestChoice(prefs.getUShort("ovmi", 1), OVERHEAD_CHOICES, OVERHEAD_COUNT);
  settings.show_card    = prefs.getBool  ("card",   true);
  prefs.end();
}

