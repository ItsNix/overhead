// ── Color clock face (from colorclock) ────────────────────────────────────
// Shown while no aircraft are airborne within range. Background = the time as
// RGB: R = hour/23, G = minute/59, B = second/59, each scaled to 0-255; text
// in whichever gray contrasts best.
inline uint8_t mapH(int h) { return (uint8_t)((h * 255) / 23); }
inline uint8_t mapM(int m) { return (uint8_t)((m * 255) / 59); }
inline uint8_t mapS(int s) { return (uint8_t)((s * 255) / 59); }

// Background gamma correction: the basic board's TN panel shows mid-tones
// pale. The hex and R/G/B readouts still show the uncorrected values.
uint8_t gammaLut[256];

void buildGammaLut() {
  for (int i = 0; i < 256; i++) gammaLut[i] = (uint8_t)lroundf(powf(i / 255.0f, settings.gamma) * 255.0f);
}

static uint16_t linearise(uint8_t c) {
  float cf  = c / 255.0f;
  float lin = (cf <= 0.04045f) ? (cf / 12.92f) : powf((cf + 0.055f) / 1.055f, 2.4f);
  return (uint16_t)(lin * 1000.0f);
}

static uint32_t luminance1000(uint8_t r, uint8_t g, uint8_t b) {
  return (212UL * linearise(r) + 715UL * linearise(g) + 72UL * linearise(b)) / 1000UL;
}

// WCAG contrast ratio x100 between two luminances (x1000).
static uint32_t contrastRatio100(uint32_t L1, uint32_t L2) {
  uint32_t hi = max(L1, L2) + 50, lo = min(L1, L2) + 50;
  return (hi * 100UL) / lo;
}

uint16_t bestTextColor(uint8_t r, uint8_t g, uint8_t b) {
  uint32_t bgLum = luminance1000(r, g, b);
  static const uint8_t grays[] = {255, 0, 180, 80};
  uint32_t bestCR = 0;
  uint16_t bestCol = TFT_WHITE;
  for (uint8_t v : grays) {
    uint32_t cr = contrastRatio100(bgLum, luminance1000(v, v, v));
    if (cr > bestCR) { bestCR = cr; bestCol = rgb888to565(v, v, v); }
  }
  return bestCol;
}

// Digits only ("13:05:09" or "1:05:09"); AM/PM drawn separately.
String clockDigits(const struct tm& ti) {
  String out;
  if (settings.format_24h) out = pad2(ti.tm_hour);
  else { int h12 = ti.tm_hour % 12; out = String(h12 ? h12 : 12); }
  out += ":" + pad2(ti.tm_min);
  if (settings.show_seconds) out += ":" + pad2(ti.tm_sec);
  return out;
}

void drawColorClock(const struct tm* ti) {
  if (!ti) {   // no time yet (basic board before NTP): plain screen
    drawStatus("Overhead", "Waiting for the time...", TFT_CYAN);
    presentFrame();
    return;
  }
  uint8_t R = mapH(ti->tm_hour), G = mapM(ti->tm_min), B = mapS(ti->tm_sec);
  uint8_t dR = gammaLut[R], dG = gammaLut[G], dB = gammaLut[B];   // as displayed
  uint16_t bg = rgb888to565(dR, dG, dB);
  uint16_t fg = bestTextColor(dR, dG, dB);
  spr.fillSprite(bg);
  spr.setTextColor(fg, bg);
  spr.setTextDatum(MC_DATUM);

  char hex[8];
  snprintf(hex, sizeof(hex), "#%02X%02X%02X", R, G, B);
  useFont(font56);
  spr.drawString(hex, SCREEN_W / 2, 50);

  // Time: digits pre-rendered at the size for this format, AM/PM beside them.
  String digits = clockDigits(*ti);
  const char* suffix = settings.format_24h ? "" : ti->tm_hour < 12 ? "AM" : "PM";
  SmoothFont& tf = !settings.show_seconds ? fontTimeL : settings.format_24h ? fontTimeM : fontTimeS;
  useFont(tf);
  int digitsW = spr.textWidth(digits), digitsH = spr.fontHeight(), suffixW = 0;
  if (*suffix) { useFont(font56); suffixW = TIME_SUFFIX_GAP + spr.textWidth(suffix); }
  int x = (SCREEN_W - digitsW - suffixW) / 2;
  int baseline = (settings.show_date ? 205 : 240) + digitsH / 2;
  spr.setTextDatum(L_BASELINE);
  useFont(tf);
  spr.drawString(digits, x, baseline);
  if (*suffix) { useFont(font56); spr.drawString(suffix, x + digitsW + TIME_SUFFIX_GAP, baseline); }
  spr.setTextDatum(MC_DATUM);

  if (settings.show_date) {
    useFont(font56);
    spr.drawString(String(dayNames[ti->tm_wday]) + "  " + pad2(ti->tm_mday) + " " +
                   monthNames[ti->tm_mon] + " " + String(1900 + ti->tm_year), SCREEN_W / 2, 365);
  }
  useFont(font24);
  char rgb[28];
  snprintf(rgb, sizeof(rgb), "R:%3d   G:%3d   B:%3d", R, G, B);
  spr.drawString(rgb, SCREEN_W / 2, 450);

  // Corner tag when the sky only looks empty because there's no data.
  const char* tag = !wifiOnline ? "No WiFi"
                  : (!feed.okAt || msSince(feed.okAt) > STALE_MS) ? "No aircraft data" : nullptr;
  if (tag) {
    spr.setTextDatum(TR_DATUM);
    spr.drawString(tag, SCREEN_W - 16, 12);
    spr.setTextDatum(MC_DATUM);
  }
  presentFrame();
}

// Which view the main screen shows when there's no overhead card.
uint32_t lastAircraftAt = 0;      // millis() when aircraft were last in range; 0 = never
uint32_t peekUntil = 0;           // radar forced on by a tap on the clock; 0 = none

int aircraftInRange() {
  int n = 0;
  for (int i = 0; i < viewCount; i++) {
    if (viewAc[i].alt != ALT_GROUND && viewAc[i].dist_nm <= settings.range_nm) n++;
  }
  return n;
}

// Radar while aircraft are airborne within range; the color clock once the sky
// has been empty (or the feed down) for CLOCK_AFTER_MS, or before any aircraft
// have been seen. A tap on the clock peeks at the radar for PEEK_MS.
bool showClockFace() {
  if (!settings.color_clock || !homeSet()) return false;
  uint32_t now = millis();
  if (peekUntil && (int32_t)(now - peekUntil) < 0) return false;
  peekUntil = 0;
  bool fresh = feed.okAt && msSince(feed.okAt) <= STALE_MS;
  if (fresh && aircraftInRange() > 0) lastAircraftAt = now | 1;
  return !lastAircraftAt || msSince(lastAircraftAt) >= CLOCK_AFTER_MS;
}

void drawFrame(const struct tm* ti) {
  uint32_t now = millis();
  if (selHex[0] && ((int32_t)(now - selUntil) >= 0 || findAircraft(selHex) < 0)) selHex[0] = 0;

  drawRadarBackground();
  if (homeSet()) drawAircraft(now); else { hitCount = 0; drawNoHome(); }

  spr.fillRect(PANEL_X, 0, PANEL_W, SCREEN_H, COL_PANEL);
  spr.drawFastVLine(PANEL_X, 0, SCREEN_H, COL_RING);
  drawClock(ti);
  spr.drawFastHLine(PANEL_X + 12, 120, PANEL_W - 24, COL_RING);
  int sel = selHex[0] ? findAircraft(selHex) : -1;
  if (sel >= 0) { listCount = 0; drawDetail(viewAc[sel], now); }
  else drawList(now);
  drawStatusLine(now);
  drawRangeButtons();
  presentFrame();
}

// ── Overhead card ─────────────────────────────────────────────────────────
// Full screen while an airborne aircraft is within the overhead radius; closes
// once it is CARD_EXIT_FACTOR past it (or missing from 3 feeds), or on a tap.
// A dismissed aircraft doesn't reopen the card until it has left.
#define PHOTO_W 420
#define PHOTO_H 280

char        cardHex[7] = "";      // aircraft on the card; "" = no card
char        dismissedHex[7] = "";
int         cardMissing = 0;      // consecutive feeds without the card's aircraft
uint32_t    cardOpenedAt = 0;     // millis() | 1
CardInfo    card = {};            // loop's copy; card.jpg is not used here
uint32_t    cardSeenVersion = 0;
LGFX_Sprite photo;
bool        photoOk = false;

bool cardShowing() { return cardHex[0] != 0; }

void requestCard(const Aircraft& a) {
  xSemaphoreTake(dataMutex, portMAX_DELAY);
  strlcpy(cardReq.hex, a.hex, sizeof(cardReq.hex));
  strlcpy(cardReq.callsign, a.flight, sizeof(cardReq.callsign));
  cardReq.lat = a.lat;
  cardReq.lon = a.lon;
  xSemaphoreGive(dataMutex);
  if (fetchTaskHandle) xTaskNotifyGive(fetchTaskHandle);
}

void openCard(const Aircraft& a) {
  strlcpy(cardHex, a.hex, sizeof(cardHex));
  cardOpenedAt = millis() | 1;
  cardMissing = 0;
  selHex[0] = 0;
  if (strcmp(card.hex, a.hex) != 0) { memset(&card, 0, sizeof(card)); photoOk = false; }
  requestCard(a);
  float d, t;
  closestApproach(a, d, t);
  Serial.printf("Card open: %s %.2f nm, closest %.2f nm in %.0f s\n", aircraftName(a).c_str(), a.dist_nm, d, t);
}

void closeCard(const char* why) {
  Serial.printf("Card closed (%s) after %lu s\n", why, (unsigned long)(msSince(cardOpenedAt) / 1000));
  cardHex[0] = 0;
}

// Where the aircraft passes closest to home if it holds its track and speed:
// distance (nm) and seconds from now (negative = already past). Without a
// track / speed it's just the current distance, now.
void closestApproach(const Aircraft& a, float& dNm, float& tSec) {
  double lat, lon;
  extrapolate(a, millis(), lat, lon);
  float px = (float)((lon - settings.home_lon) * 60.0 * cos(settings.home_lat * DEG));
  float py = (float)((lat - settings.home_lat) * 60.0);
  dNm = sqrtf(px * px + py * py);
  tSec = 0;
  if (a.gs <= 0 || a.track < 0 || a.alt == ALT_GROUND) return;
  float vx = a.gs / 3600.0f * sinf(a.track * DEG), vy = a.gs / 3600.0f * cosf(a.track * DEG);
  tSec = -(px * vx + py * vy) / (vx * vx + vy * vy);
  if (tSec < 0) return;     // moving away: closest is now
  float cx = px + vx * tSec, cy = py + vy * tSec;
  dNm = sqrtf(cx * cx + cy * cy);
}

// Worth a card: airborne, and overhead now or about to be (within the radius
// at its closest approach in the next CARD_LEAD_S).
bool cardWorthy(const Aircraft& a, float radiusNm) {
  if (a.alt == ALT_GROUND) return false;
  if (a.dist_nm <= radiusNm) return true;
  float d, t;
  closestApproach(a, d, t);
  return d <= radiusNm && t <= CARD_LEAD_S;
}

// Called with each new feed. Opens a card ahead of the closest approach and
// keeps it up at least CARD_MIN_MS, so fast / high traffic is still readable.
void updateCard() {
  float exitNm = overheadNm() * CARD_EXIT_FACTOR;
  if (dismissedHex[0]) {
    int i = findAircraft(dismissedHex);
    if (i < 0 || !cardWorthy(viewAc[i], exitNm)) dismissedHex[0] = 0;
  }
  if (cardShowing()) {
    int i = findAircraft(cardHex);
    bool minShown = msSince(cardOpenedAt) >= CARD_MIN_MS;
    if (!settings.show_card)                    closeCard("turned off");
    else if (i < 0)                             { if (++cardMissing >= 3) closeCard("gone"); }
    else {
      cardMissing = 0;
      if (viewAc[i].alt == ALT_GROUND)                    { if (minShown) closeCard("landed"); }
      else if (!cardWorthy(viewAc[i], exitNm) && minShown) closeCard("passed");
    }
  }
  if (!cardShowing() && settings.show_card && !configOpen) {
    float r = overheadNm();
    for (int i = 0; i < viewCount; i++) {   // nearest first
      if (cardWorthy(viewAc[i], r) && strcmp(viewAc[i].hex, dismissedHex) != 0) { openCard(viewAc[i]); break; }
    }
  }
}

// Picks up finished lookups; decodes the photo once into a PSRAM sprite.
bool pullCard() {
  uint8_t* jpg = nullptr;
  size_t len = 0;
  xSemaphoreTake(dataMutex, portMAX_DELAY);
  bool fresh = cardVersion != cardSeenVersion;
  if (fresh) {
    cardSeenVersion = cardVersion;
    card = cardShared;
    card.jpg = nullptr;
    if (cardShared.jpg && (jpg = (uint8_t*)heap_caps_malloc(cardShared.jpg_len, MALLOC_CAP_SPIRAM))) {
      memcpy(jpg, cardShared.jpg, cardShared.jpg_len);
      len = cardShared.jpg_len;
    }
  }
  xSemaphoreGive(dataMutex);
  if (!fresh) return false;
  photoOk = false;
  if (jpg) {
    if (!photo.getBuffer()) {
      photo.setPsram(true);
      photo.setColorDepth(16);
      photo.createSprite(PHOTO_W, PHOTO_H);
    }
    if (photo.getBuffer()) {
      photo.fillSprite(COL_ROW);
      photoOk = photo.drawJpg(jpg, len, 0, 0, PHOTO_W, PHOTO_H, 0, 0, 0.0f, 0.0f, lgfx::datum_t::middle_center);
      if (!photoOk) Serial.printf("Photo: couldn't decode %u bytes\n", (unsigned)len);
    }
    heap_caps_free(jpg);
  }
  return true;
}

// Shortens s with "..." until it fits w px in the current font.
String fitText(String s, int w) {
  if (spr.textWidth(s) <= w) return s;
  while (s.length() > 1 && spr.textWidth(s + "...") > w) s.remove(s.length() - 1);
  return s + "...";
}

void drawCardRow(int y, const char* label, const String& value, uint16_t col = TFT_WHITE) {
  const int x0 = 456, x1 = SCREEN_W - 20;
  useFont(font20);
  spr.setTextDatum(ML_DATUM);
  spr.setTextColor(COL_DIM_TEXT);
  spr.drawString(label, x0, y);
  useFont(font24);
  spr.setTextDatum(MR_DATUM);
  spr.setTextColor(col);
  spr.drawString(value, x1, y);
}

void drawCard(const Aircraft& a, const struct tm* ti) {
  const uint16_t BG = rgb888to565(12, 16, 24);
  uint32_t now = millis();
  uint16_t altCol = altColor(a.alt);
  bool ready = !strcmp(card.hex, a.hex) && card.done;
  spr.fillSprite(BG);
  spr.fillRect(0, 0, 10, SCREEN_H, altCol);

  // Header: callsign, operator; distance from home on the right.
  double lat, lon;
  extrapolate(a, now, lat, lon);
  float dMi = distanceNm(settings.home_lat, settings.home_lon, lat, lon) / NM_PER_MI;
  float b = bearingDeg(settings.home_lat, settings.home_lon, lat, lon);
  useFont(font20);
  spr.setTextDatum(TR_DATUM);
  float cpaNm, cpaS;
  closestApproach(a, cpaNm, cpaS);
  String state = dMi * NM_PER_MI <= overheadNm() ? String("OVERHEAD")
               : cpaS > 2 ? "OVERHEAD IN " + String((int)lroundf(cpaS)) + " s"
               : String("PASSED");
  spr.setTextColor(COL_ALERT);
  spr.drawString(state, SCREEN_W - 20, 16);
  useFont(font32);
  spr.setTextColor(TFT_WHITE);
  int distW = spr.drawString((dMi < 10 ? String(dMi, 1) : String((int)lroundf(dMi))) + " mi " + compass8(b),
                             SCREEN_W - 20, 44);
  useFont(font56);
  spr.setTextDatum(TL_DATUM);
  spr.drawString(fitText(aircraftName(a), SCREEN_W - 70 - max(distW, 120)), 28, 8);
  useFont(font24);
  spr.setTextColor(COL_DIM_TEXT);
  String sub = ready && card.owner[0] ? String(card.owner) : String(ready ? "" : "Looking up...");
  spr.drawString(fitText(sub, SCREEN_W - 48), 28, 70);

  // Photo, or a big silhouette pointing along the track.
  const int px = 20, py = 108;
  if (photoOk && ready) {
    photo.pushSprite(&spr, px, py);
    useFont(font16);
    spr.setTextDatum(TL_DATUM);
    spr.setTextColor(COL_DIM_TEXT);
    spr.drawString(fitText(String(card.photographer) + " / planespotters.net", PHOTO_W),
                   px, py + PHOTO_H + 6);
  } else {
    spr.fillRoundRect(px, py, PHOTO_W, PHOTO_H, 10, COL_ROW);
    drawPlane(px + PHOTO_W / 2, py + PHOTO_H / 2, a.track >= 0 ? a.track : 0, 200, altCol);
  }

  // Right column: route, model, registration / type, live values.
  const int x0 = 456, w = SCREEN_W - 20 - x0;
  spr.setTextDatum(TL_DATUM);
  if (ready && card.from_code[0]) {
    useFont(font40);
    spr.setTextColor(TFT_WHITE);
    spr.drawString(String(card.from_code) + " \xE2\x86\x92 " + card.to_code, x0, py - 4);
    useFont(font20);
    spr.setTextColor(COL_DIM_TEXT);
    spr.drawString(fitText(String(card.from_city) + " \xE2\x86\x92 " + card.to_city, w), x0, py + 42);
  } else {
    useFont(font24);
    spr.setTextColor(COL_DIM_TEXT);
    spr.drawString(ready ? "Route unknown" : "", x0, py + 6);
  }
  useFont(font24);
  spr.setTextColor(TFT_WHITE);
  String model = ready && card.model[0] ? String(card.model) : String(a.type);
  spr.drawString(fitText(model, w), x0, py + 78);
  useFont(font20);
  spr.setTextColor(COL_DIM_TEXT);
  String ids = a.reg;
  if (a.type[0]) ids += (ids.length() ? "  " : "") + String(a.type);
  String hex = a.hex; hex.toUpperCase();
  ids += (ids.length() ? "  " : "") + hex;
  spr.drawString(fitText(ids, w), x0, py + 110);

  int y = py + 160;
  const int step = 36;
  drawCardRow(y, "Altitude", altString(a.alt) + (a.alt > ALT_GROUND && a.alt < 18000 ? " ft" : ""), altCol);
  y += step;
  drawCardRow(y, "Vertical", a.rate ? (a.rate > 0 ? "+" : "") + String(a.rate) + " fpm" : "level"); y += step;
  drawCardRow(y, "Speed", a.gs >= 0 ? String(a.gs) + " kt" : "-");                                 y += step;
  drawCardRow(y, "Track", a.track >= 0 ? String(a.track) + "\xC2\xB0 " + compass8(a.track) : "-");  y += step;
  if (a.squawk[0]) {
    bool emergency = !strcmp(a.squawk, "7700") || !strcmp(a.squawk, "7600") || !strcmp(a.squawk, "7500");
    drawCardRow(y, "Squawk", a.squawk, emergency ? COL_ALERT : TFT_WHITE);
  }

  // Footer: time and how to close.
  useFont(font20);
  spr.setTextColor(COL_DIM_TEXT);
  spr.setTextDatum(BL_DATUM);
  if (ti) {
    char t[12];
    if (settings.format_24h) snprintf(t, sizeof(t), "%02d:%02d", ti->tm_hour, ti->tm_min);
    else snprintf(t, sizeof(t), "%d:%02d %s", ti->tm_hour % 12 ? ti->tm_hour % 12 : 12, ti->tm_min,
                  ti->tm_hour < 12 ? "AM" : "PM");
    spr.drawString(t, 28, SCREEN_H - 12);
  }
  spr.setTextDatum(BR_DATUM);
  spr.drawString("Tap to close", SCREEN_W - 20, SCREEN_H - 12);
  presentFrame();
}

void stepRange(int dir) {
  int i = 0;
  while (i < RANGE_COUNT - 1 && RANGE_CHOICES[i] < settings.range_nm) i++;
  i = constrain(i + dir, 0, RANGE_COUNT - 1);
  if (RANGE_CHOICES[i] == settings.range_nm) return;
  settings.range_nm = RANGE_CHOICES[i];
  Serial.printf("Range %u nm\n", settings.range_nm);
  publishFetchConfig(true);
  rangeSaveAt = (millis() + RANGE_SAVE_MS) | 1;   // save once the buttons go quiet
}

// Taps on the main view: aircraft on the radar, list rows, range buttons.
void handleViewTouch() {
  if (!touch.started) return;
  int x = touch.x, y = touch.y;
  radarDirty = true;
  if (cardShowing()) {
    strlcpy(dismissedHex, cardHex, sizeof(dismissedHex));
    closeCard("tapped");
    return;
  }
  if (clockShowing) {
    peekUntil = (millis() + PEEK_MS) | 1;
    return;
  }
  if (x < PANEL_X) {
    int best = -1, bestD = 40 * 40;
    for (int i = 0; i < hitCount; i++) {
      int dx = hits[i].x - x, dy = hits[i].y - y, d = dx * dx + dy * dy;
      if (d < bestD) { bestD = d; best = hits[i].index; }
    }
    if (best >= 0) {
      strlcpy(selHex, viewAc[best].hex, sizeof(selHex));
      selUntil = millis() + SELECT_MS;
    } else {
      selHex[0] = 0;
    }
    return;
  }
  if (y >= RANGE_Y) {
    if (x < PANEL_X + 100) stepRange(-1);
    else if (x >= SCREEN_W - 100) stepRange(1);
    return;
  }
  if (y >= LIST_Y && y < STATUS_Y) {
    if (selHex[0]) { selHex[0] = 0; return; }     // tap the detail card to close it
    int row = (y - LIST_Y) / LIST_ROW_H;
    if (row < listCount) {
      strlcpy(selHex, viewAc[listIndex[row]].hex, sizeof(selHex));
      selUntil = millis() + SELECT_MS;
    }
  }
}

// ── On-screen settings ──────────────────────────────────────────────────────
// Opened by tapping the top-left and top-right corners (either order) within
// CORNER_WINDOW_MS while the screen is lit (normal or dim). The IP address, if
// connected, is shown along the bottom. Changes apply live; Done, or
// CONFIG_IDLE_MS without a touch, saves and returns to the radar.
#define CORNER_W          160
#define CORNER_H          120
#define CORNER_WINDOW_MS  5000
#define CONFIG_IDLE_MS    60000
#define REPEAT_DELAY_MS   500     // hold +/- this long to auto-repeat
#define REPEAT_MS         120
#define DIM_PREVIEW_MS    2000    // show the dim level this long after changing it

#define TAB_W     (SCREEN_W / 6)  // 5 page tabs + Done across the top
#define HEADER_H  80
#define ROWS_Y    100
#define ROW_H     85
#define CTRL_H    64
#define FOOTER_Y  (SCREEN_H - 20)   // WiFi line, below the last row
#define WIFI_BTN_X 570              // "Change WiFi" button in the footer
#define WIFI_BTN_Y 442
#define WIFI_BTN_W 220
#define WIFI_BTN_H 36

const char* configTabs[] = {"Radar", "Clock", "Dim", "Off", "Overhead"};
int configPageCount() { return 5; }

int configRows(int page, ConfigRow* rows) {
  switch (page) {
    case 0:
      rows[0] = {"Brightness",   ROW_PERCENT, &settings.brightness, 5, 100};
      rows[1] = {"Range",        ROW_CHOICE,  &settings.range_nm, 0, 0, RANGE_CHOICES, RANGE_COUNT, "nm"};
      rows[2] = {"Labels",       ROW_TOGGLE,  &settings.labels};
      rows[3] = {"Trails",       ROW_TOGGLE,  &settings.trails};
      return 4;
    case 1:
      rows[0] = {"Color clock",  ROW_TOGGLE,  &settings.color_clock};
      rows[1] = {"24-hour",      ROW_TOGGLE,  &settings.format_24h};
      rows[2] = {"Seconds",      ROW_TOGGLE,  &settings.show_seconds};
      rows[3] = {"Date",         ROW_TOGGLE,  &settings.show_date};
      return 4;
    case 2:
      rows[0] = {"Dim screen",   ROW_TOGGLE,  &settings.dim_enabled};
      rows[1] = {"From",         ROW_TIME,    &settings.dim_start};
      rows[2] = {"Until",        ROW_TIME,    &settings.dim_end};
      rows[3] = {"Brightness",   ROW_PERCENT, &settings.dim_level, 5, 100};
      return 4;
    case 3:
      rows[0] = {"Screen off",   ROW_TOGGLE,  &settings.off_enabled};
      rows[1] = {"From",         ROW_TIME,    &settings.off_start};
      rows[2] = {"Until",        ROW_TIME,    &settings.off_end};
      return 3;
    default:
      rows[0] = {"Within",       ROW_CHOICE,  &settings.overhead_mi, 0, 0, OVERHEAD_CHOICES, OVERHEAD_COUNT, "mi"};
      rows[1] = {"Show card",    ROW_TOGGLE,  &settings.show_card};
      if (!CrowPanel7::hasBuzzer()) return 2;
      rows[2] = {"Beep",         ROW_TOGGLE,  &settings.alert};
      rows[3] = {"Test beep",    ROW_ACTION,  nullptr};
      return 4;
  }
}

int      configPage = 0;
bool     configDirty = false;     // redraw needed
uint32_t configLastTouch = 0;
uint32_t dimPreviewUntil = 0;     // 0 = no preview
int      heldRow = -1, heldDir = 0;
uint32_t nextRepeat = 0;
uint32_t cornerTapL = 0, cornerTapR = 0;   // millis() of the last tap in each top corner
String   configIp;                // IP shown in the footer; "" = not connected

void openConfig() {
  configOpen = true;
  configPage = 0;
  configDirty = true;
  configLastTouch = millis();
  heldRow = -1;
  selHex[0] = 0;
  Serial.println("On-screen settings opened");
}

void closeConfig() {
  configOpen = false;
  dimPreviewUntil = 0;
  saveSettings();
  rangeSaveAt = 0;
  publishFetchConfig(true);
  logSettings("Saved (on screen)");
  radarDirty = true;
  // Stay at normal brightness for wake_s, as after a tap, so a dim / off
  // schedule doesn't blank the screen the instant Done is pressed.
  wakeLevel = settings.brightness;
  wakeUntil = (millis() + settings.wake_s * 1000UL) | 1;
}

// A tap in one top corner, then the other within CORNER_WINDOW_MS, opens the settings.
void checkCornerTaps() {
  if (!touch.started || touch.y >= CORNER_H) return;
  uint32_t now = millis(), other;
  if (touch.x < CORNER_W)                  { cornerTapL = now | 1; other = cornerTapR; }
  else if (touch.x >= SCREEN_W - CORNER_W) { cornerTapR = now | 1; other = cornerTapL; }
  else return;
  if (other && now - other <= CORNER_WINDOW_MS) {
    cornerTapL = cornerTapR = 0;
    openConfig();
  }
}

String configTimeString(uint16_t minutes) {
  if (settings.format_24h) return hhmm(minutes);
  int h = minutes / 60, h12 = h % 12 ? h % 12 : 12;
  return String(h12) + ":" + pad2(minutes % 60) + (h < 12 ? " AM" : " PM");
}

void drawButton(int x, int y, int w, int h, uint16_t bg, const char* text, uint16_t fg) {
  spr.fillRoundRect(x, y, w, h, 12, bg);
  if (text) {
    spr.setTextColor(fg, bg);
    spr.drawString(text, x + w / 2, y + h / 2);
  }
}

// +/- drawn as bars: the fonts are ASCII-only and a text '-' is too thin to aim at.
void drawStepButton(int x, int y, int w, int h, uint16_t bg, bool plus) {
  drawButton(x, y, w, h, bg, nullptr, 0);
  int cx = x + w / 2, cy = y + h / 2;
  spr.fillRect(cx - 16, cy - 4, 32, 8, TFT_WHITE);
  if (plus) spr.fillRect(cx - 4, cy - 16, 8, 32, TFT_WHITE);
}

void drawConfig(const ConfigRow* rows, int n) {
  const uint16_t BG     = rgb888to565(18, 18, 22);
  const uint16_t PANEL  = rgb888to565(58, 58, 66);
  const uint16_t GREEN  = rgb888to565(40, 160, 90);

  spr.fillSprite(BG);
  spr.setTextDatum(MC_DATUM);
  useFont(font40);
  for (int t = 0; t < configPageCount(); t++) {
    bool active = t == configPage;
    useFont(font40);
    if (spr.textWidth(configTabs[t]) > TAB_W - 28) useFont(font32);
    if (spr.textWidth(configTabs[t]) > TAB_W - 28) useFont(font24);
    if (spr.textWidth(configTabs[t]) > TAB_W - 28) useFont(font20);
    drawButton(t * TAB_W + 6, 8, TAB_W - 12, HEADER_H - 16, active ? COL_ACCENT : PANEL,
               configTabs[t], active ? TFT_BLACK : TFT_WHITE);
  }
  useFont(font32);
  drawButton(configPageCount() * TAB_W + 6, 8, TAB_W - 12, HEADER_H - 16, GREEN, "Done", TFT_WHITE);

  for (int i = 0; i < n; i++) {
    const ConfigRow& r = rows[i];
    int cy = ROWS_Y + i * ROW_H + ROW_H / 2, top = cy - CTRL_H / 2;
    useFont(font40);
    spr.setTextDatum(ML_DATUM);
    spr.setTextColor(TFT_WHITE, BG);
    spr.drawString(r.label, 40, cy);
    spr.setTextDatum(MC_DATUM);

    if (r.kind == ROW_TOGGLE) {
      bool on = *(bool*)r.value;
      drawButton(600, top, 180, CTRL_H, on ? GREEN : PANEL, on ? "ON" : "OFF", TFT_WHITE);
    } else if (r.kind == ROW_ACTION) {
      drawButton(560, top, 220, CTRL_H, PANEL, "Play", TFT_WHITE);
    } else {
      String v = r.kind == ROW_PERCENT ? String(*(uint8_t*)r.value) + "%"
               : r.kind == ROW_CHOICE  ? String(*(uint16_t*)r.value) + " " + r.unit
                                       : configTimeString(*(uint16_t*)r.value);
      drawStepButton(410, top, 90, CTRL_H, PANEL, false);
      drawStepButton(690, top, 90, CTRL_H, PANEL, true);
      if (spr.textWidth(v) > 180) useFont(font24);
      spr.setTextColor(TFT_WHITE, BG);
      spr.drawString(v, 595, cy);
    }
  }

  // Footer: network and IP, and a button to change the network (works offline too).
  configIp = currentIp();
  useFont(font20);
  spr.setTextDatum(ML_DATUM);
  spr.setTextColor(rgb888to565(150, 150, 160), BG);
  String ssid = WiFi.SSID();
  if (!ssid.length()) ssid = portalWm.getWiFiSSID();
  String line = configIp.length() ? "WiFi: " + ssid + "   IP: " + configIp
                                  : "WiFi: not connected" + (ssid.length() ? " (" + ssid + ")" : String(""));
  spr.drawString(line, 24, FOOTER_Y);
  spr.setTextDatum(MC_DATUM);
  drawButton(WIFI_BTN_X, WIFI_BTN_Y, WIFI_BTN_W, WIFI_BTN_H, PANEL, "Change WiFi", TFT_WHITE);
  presentFrame();
}

// Percent in steps of 5; times in steps of 15 min, snapped to the quarter hour,
// wrapping at midnight; choices to the next / previous value.
void stepRow(const ConfigRow& r, int dir) {
  if (r.kind == ROW_PERCENT) {
    uint8_t* v = (uint8_t*)r.value;
    *v = constrain((int)*v + dir * 5, (int)r.min, (int)r.max);
    if (v == &settings.dim_level) dimPreviewUntil = (millis() + DIM_PREVIEW_MS) | 1;
  } else if (r.kind == ROW_TIME) {
    uint16_t* v = (uint16_t*)r.value;
    int m = dir > 0 ? (*v / 15 + 1) * 15 : ((*v + 14) / 15 - 1) * 15;
    *v = (m + 24 * 60) % (24 * 60);
  } else if (r.kind == ROW_CHOICE) {
    uint16_t* v = (uint16_t*)r.value;
    int i = 0;
    while (i < r.nChoices - 1 && r.choices[i] < *v) i++;
    *v = r.choices[constrain(i + dir, 0, r.nChoices - 1)];
  }
  configDirty = true;
}

void handleConfigTouch(const ConfigRow* rows, int n) {
  int x = touch.x, y = touch.y;
  if (y < HEADER_H) {
    int slot = x / TAB_W;
    if (slot == configPageCount()) { closeConfig(); return; }
    if (slot < configPageCount() && slot != configPage) { configPage = slot; configDirty = true; }
    return;
  }
  if (y >= WIFI_BTN_Y - 10 && x >= WIFI_BTN_X) {
    closeConfig();
    startPortal("Opened from the on-screen settings");
    return;
  }
  int i = (y - ROWS_Y) / ROW_H;
  if (y < ROWS_Y || i >= n) return;
  const ConfigRow& r = rows[i];
  if (r.kind == ROW_TOGGLE && x >= 560) {
    *(bool*)r.value = !*(bool*)r.value;
    configDirty = true;
  } else if (r.kind == ROW_ACTION && x >= 520) {
    startBeep();
  } else if (r.kind == ROW_PERCENT || r.kind == ROW_TIME || r.kind == ROW_CHOICE) {
    int dir = x >= 380 && x < 520 ? -1 : x >= 670 ? 1 : 0;
    if (!dir) return;
    stepRow(r, dir);
    heldRow = i; heldDir = dir;
    nextRepeat = millis() + REPEAT_DELAY_MS;
  }
}

// One loop pass while the settings are open.
void runConfig() {
  uint32_t now = millis();
  ConfigRow rows[4];
  int n = configRows(configPage, rows);

  if (touch.down) configLastTouch = now;
  if (!touch.down) heldRow = -1;
  if (touch.started) {
    heldRow = -1;
    handleConfigTouch(rows, n);
    if (!configOpen) return;
    n = configRows(configPage, rows);   // the page may have changed
  } else if (heldRow >= 0 && (int32_t)(now - nextRepeat) >= 0) {
    stepRow(rows[heldRow], heldDir);
    nextRepeat = now + REPEAT_MS;
  }
  if (now - configLastTouch >= CONFIG_IDLE_MS) { closeConfig(); return; }

  if (dimPreviewUntil && (int32_t)(now - dimPreviewUntil) >= 0) dimPreviewUntil = 0;
  setBacklightLevel(dimPreviewUntil ? min(settings.dim_level, settings.brightness)
                                    : settings.brightness, "settings");

  if (currentIp() != configIp) configDirty = true;
  if (configDirty) {
    configDirty = false;
    drawConfig(rows, n);
  } else {
    delay(20);
  }
}

// ── Setup ───────────────────────────────────────────────────────────────────
void setup() {
  Serial.begin(115200);
  Serial.printf("Board: %s\n", CrowPanel7::boardName());

  if (!display.begin()) {
    Serial.println("Display init failed — is OPI PSRAM enabled in the board options?");
    while (true) delay(1000);
  }
  bindSprite();
  loadFonts();
  initColors();
  spr.setTextDatum(MC_DATUM);

  loadSettings();
  buildGammaLut();
  restoreTimeFromRtc();
  trails = (Trail*)heap_caps_calloc(MAX_TRAILS, sizeof(Trail), MALLOC_CAP_SPIRAM);

  Serial.printf("Display %dx%d, double-buffered, %.1f fps; free internal RAM %u KB, PSRAM %u KB\n",
                SCREEN_W, SCREEN_H, display.measureFps(),
                heap_caps_get_free_size(MALLOC_CAP_INTERNAL) / 1024,
                heap_caps_get_free_size(MALLOC_CAP_SPIRAM) / 1024);
  logSettings("Loaded");

  // First frame is drawn into a framebuffer before the backlight comes on,
  // so the panel never shows uninitialized memory.
  showStatus("Overhead", "Starting...", TFT_CYAN);
  backlightLevel = settings.brightness;
  display.setBrightness(backlightLevel);

  setupWiFi();
  applyTimeSettings();
  setupWebServer();
  startFetchTask();
  if (bootPortal) startPortal("Saved network didn't connect. The clock keeps running.");
}

// ── Loop ────────────────────────────────────────────────────────────────────
void loop() {
  server.handleClient();
  checkWiFi();
  updateBeep();
  pollTouch();

  if (ntpSynced) {
    ntpSynced = false;
    if (display.writeRtc(time(nullptr))) Serial.println("RTC set from NTP");
  }

  if (portalOpen) {
    struct tm pt;
    bool pk = localTimeNow(&pt);
    runPortal(pk ? &pt : nullptr);
    return;
  }

  if (configOpen) {
    runConfig();
    return;
  }

  if (rangeSaveAt && (int32_t)(millis() - rangeSaveAt) >= 0) {
    rangeSaveAt = 0;
    saveSettings();
    logSettings("Saved (range)");
  }

  struct tm ti;
  bool haveTime = localTimeNow(&ti);
  currentSchedule = haveTime ? scheduleAt(ti) : SCHED_NORMAL;

  // A tap that wakes a dark screen does only that. Corner taps count whenever
  // the screen was visible, so the settings open from dim too.
  bool wasVisible = backlightLevel > 0;
  bool wokeOnly = updateScreenPower(currentSchedule);
  if (wasVisible) checkCornerTaps();
  if (configOpen) return;
  if (!wokeOnly && wasVisible) handleViewTouch();

  if (pullFeed()) {
    updateTrails();
    checkAlerts();
    updateCard();
    radarDirty = true;
  }
  if (pullCard()) radarDirty = true;

  static uint32_t lastDraw = 0;
  static int lastSec = -1;
  if (clockShowing && haveTime && ti.tm_sec != lastSec) radarDirty = true;   // clock face ticks on the second
  if (haveTime) lastSec = ti.tm_sec;
  if (radarDirty || millis() - lastDraw >= REDRAW_MS) {
    radarDirty = false;
    lastDraw = millis();
    int c = cardShowing() ? findAircraft(cardHex) : -1;
    bool clock = c < 0 && showClockFace();
    if (clock != clockShowing) {
      clockShowing = clock;
      Serial.println(clock ? "View: color clock (no aircraft in range)" : "View: radar");
    }
    if (c >= 0)     drawCard(viewAc[c], haveTime ? &ti : nullptr);
    else if (clock) drawColorClock(haveTime ? &ti : nullptr);
    else            drawFrame(haveTime ? &ti : nullptr);
  } else {
    delay(beepStep ? 5 : 15);
  }
}
