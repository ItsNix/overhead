// Set from the SNTP task on each sync; loop() copies the time into the RTC
// (I2C stays on the loop task, which also owns touch and backlight).
volatile bool ntpSynced = false;
bool wifiOnline = false;

// True once the clock has been set, by the RTC or NTP (anything after 2024-01-01).
bool timeKnown() { return time(nullptr) > 1704067200; }

// Local time without waiting. Not getLocalTime(&ti, 0): its loop runs only while
// millis() - start <= 0, so it fails whenever millis() ticks between its two
// reads (~1 in 1000 calls). loop() then drew one "Waiting for the time" frame,
// which looks like the boot splash, and briefly dropped the dim/off schedule.
bool localTimeNow(struct tm* ti) {
  time_t now = time(nullptr);
  localtime_r(&now, ti);
  return timeKnown();
}

void applyTimeSettings() {
  // ESP32 built-in SNTP — handles DST via POSIX TZ string
  configTzTime(settings.tz_string.c_str(), settings.ntp_server.c_str());
  sntp_set_time_sync_notification_cb([](struct timeval*) { ntpSynced = true; });
}

// Battery-backed RTC (Advance board only): sets the clock at boot, before NTP.
void restoreTimeFromRtc() {
  time_t utc;
  if (!display.readRtc(utc)) {
    Serial.println("RTC: none, or no valid time");
    return;
  }
  timeval tv = { utc, 0 };
  settimeofday(&tv, nullptr);
  Serial.printf("RTC: %s", asctime(gmtime(&utc)));   // UTC; asctime ends in '\n'
}

// ── Colors ──────────────────────────────────────────────────────────────────
uint16_t rgb888to565(uint8_t r, uint8_t g, uint8_t b) {
  return ((uint16_t)(r & 0xF8) << 8) |
         ((uint16_t)(g & 0xFC) << 3) |
         ((uint16_t)(b >> 3));
}

// HSL (h in degrees, s / l 0..1) to RGB565.
uint16_t hsl565(float h, float s, float l, float scale = 1.0f) {
  float c = (1 - fabsf(2 * l - 1)) * s;
  float hp = fmodf(h, 360.0f) / 60.0f;
  float x = c * (1 - fabsf(fmodf(hp, 2.0f) - 1));
  float r = 0, g = 0, b = 0;
  if      (hp < 1) { r = c; g = x; }
  else if (hp < 2) { r = x; g = c; }
  else if (hp < 3) { g = c; b = x; }
  else if (hp < 4) { g = x; b = c; }
  else if (hp < 5) { r = x; b = c; }
  else             { r = c; b = x; }
  float m = l - c / 2;
  return rgb888to565((uint8_t)((r + m) * 255 * scale), (uint8_t)((g + m) * 255 * scale),
                     (uint8_t)((b + m) * 255 * scale));
}

// Altitude color ramp like tar1090's: orange low, green ~10k ft, through blue to magenta high.
uint16_t altColor(int32_t alt, float scale = 1.0f) {
  if (alt == ALT_GROUND)  return rgb888to565(110 * scale, 110 * scale, 110 * scale);
  if (alt == ALT_UNKNOWN) return rgb888to565(200 * scale, 200 * scale, 200 * scale);
  float h;
  if      (alt <= 2000)  h = 20;
  else if (alt <= 10000) h = 20 + (alt - 2000) * (120.0f / 8000.0f);
  else if (alt <= 40000) h = 140 + (alt - 10000) * (160.0f / 30000.0f);
  else                   h = 300;
  return hsl565(h, 0.85f, 0.58f, scale);
}

