String pad2(int n) { return (n < 10 ? "0" : "") + String(n); }

String formatTime(const struct tm& ti) {
  if (settings.format_24h) return pad2(ti.tm_hour) + ":" + pad2(ti.tm_min) + ":" + pad2(ti.tm_sec);
  int h12 = ti.tm_hour % 12; if (h12 == 0) h12 = 12;
  return String(h12) + ":" + pad2(ti.tm_min) + ":" + pad2(ti.tm_sec) + (ti.tm_hour < 12 ? " AM" : " PM");
}

// "HH:MM" <-> minutes after midnight (for the schedule time inputs)
String hhmm(uint16_t minutes) { return pad2(minutes / 60) + ":" + pad2(minutes % 60); }

int parseHHMM(const String& s) {
  int colon = s.indexOf(':');
  if (colon < 1) return -1;
  int h = s.substring(0, colon).toInt(), m = s.substring(colon + 1).toInt();
  if (h < 0 || h > 23 || m < 0 || m > 59) return -1;
  return h * 60 + m;
}

// "FL350" at and above 18,000 ft (US transition altitude), else "4,500".
String altString(int32_t alt) {
  if (alt == ALT_GROUND)  return "GND";
  if (alt == ALT_UNKNOWN) return "---";
  if (alt >= 18000) {
    char b[8]; snprintf(b, sizeof(b), "FL%03ld", (long)((alt + 50) / 100)); return b;
  }
  char b[12];
  if (alt >= 1000 || alt <= -1000) snprintf(b, sizeof(b), "%ld,%03ld", (long)(alt / 1000), (long)labs(alt % 1000));
  else snprintf(b, sizeof(b), "%ld", (long)alt);
  return b;
}

const char* compass8(float bearing) {
  static const char* dirs[] = {"N", "NE", "E", "SE", "S", "SW", "W", "NW"};
  return dirs[(int)((bearing + 22.5f) / 45.0f) & 7];
}

String nmString(float nm) {
  return nm < 10 ? String(nm, 1) : String((int)lroundf(nm));
}

// Callsign, else registration, else hex.
