  drawDetailRow(y, "Vertical", a.rate ? (a.rate > 0 ? "+" : "") + String(a.rate) + " fpm" : "level"); y += step;
  drawDetailRow(y, "Speed", a.gs >= 0 ? String(a.gs) + " kt" : "-");       y += step;
  drawDetailRow(y, "Track", a.track >= 0 ? String(a.track) + "\xC2\xB0" : "-"); y += step;
  drawDetailRow(y, "From home", nmString(d) + " nm " + compass8(b));       y += step;
  drawDetailRow(y, "Squawk", a.squawk[0] ? a.squawk : "-",
                !strcmp(a.squawk, "7700") || !strcmp(a.squawk, "7600") || !strcmp(a.squawk, "7500")
                  ? COL_ALERT : TFT_WHITE);
