  useFont(font32);
  spr.setTextColor(TFT_WHITE);
  spr.drawString(aircraftName(a), PANEL_X + 18, LIST_Y + 14);
  useFont(font20);
  spr.setTextColor(COL_DIM_TEXT);
  String sub = a.type;
  if (a.reg[0] && strcmp(a.reg, a.flight)) sub += (sub.length() ? "  " : "") + String(a.reg);
  String hex = a.hex; hex.toUpperCase();
  sub += (sub.length() ? "  " : "") + hex;
  spr.drawString(sub, PANEL_X + 18, LIST_Y + 50);

  double lat, lon;
  extrapolate(a, now, lat, lon);
