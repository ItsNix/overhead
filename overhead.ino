// ── Radar view ──────────────────────────────────────────────────────────────
char     selHex[7] = "";          // tapped aircraft; "" = none
uint32_t selUntil = 0;

// Screen positions from the last frame, for tap hit-testing.
struct Hit { int16_t x, y; int16_t index; };
Hit      hits[MAX_AIRCRAFT];
int      hitCount = 0;
int16_t  listIndex[LIST_ROWS];    // viewAc index per list row; -1 = empty
int      listCount = 0;

int findAircraft(const char* hex) {
  for (int i = 0; i < viewCount; i++) if (!strcmp(viewAc[i].hex, hex)) return i;
  return -1;
}

// Ring spacing: a round step giving 3-5 rings.
float ringStep(uint16_t range) {
  static const float steps[] = {50, 25, 10, 5, 2.5f, 2, 1, 0.5f};
  for (float s : steps) if (range / s >= 3) return s;
  return 0.5f;
}

String ringLabel(float nm) {
  return nm == (int)nm ? String((int)nm) : String(nm, 1);
}

// Plane silhouette as triangles, nose toward -y, ~24 units long.
const int8_t PLANE_TRIS[][6] = {
  {  0,-12,  -2, -7,   2, -7 },   // nose
  { -2, -7,   2, -7,   2,  8 },   // fuselage
  { -2, -7,   2,  8,  -2,  8 },
  { -2, -3, -12,  4,  -2,  3 },   // wings
  {  2, -3,  12,  4,   2,  3 },
  { -1,  6,  -6, 11,  -1,  9 },   // tailplane
  {  1,  6,   6, 11,   1,  9 },
  { -2,  8,   2,  8,   0, 11 },   // tail cone
};

void drawPlane(float cx, float cy, float trackDeg, float size, uint16_t col) {
  float s = size / 24.0f, c = cosf(trackDeg * DEG), n = sinf(trackDeg * DEG);
  for (auto& t : PLANE_TRIS) {
    int p[6];
    for (int k = 0; k < 6; k += 2) {
      float x = t[k] * s, y = t[k + 1] * s;
      p[k]     = lroundf(cx + x * c - y * n);
      p[k + 1] = lroundf(cy + x * n + y * c);
    }
    spr.fillTriangle(p[0], p[1], p[2], p[3], p[4], p[5], col);
  }
}

// Icon size from the emitter category (light ... heavy).
float planeSize(const Aircraft& a) {
  if (a.cat[0] == 'A') {
    switch (a.cat[1]) {
      case '1': return 18;
      case '2': return 21;
      case '5': return 30;
      case '6': return 26;   // high performance
    }
  }
  return 25;
}

void drawRadarBackground() {
  spr.fillRect(0, 0, PANEL_X, SCREEN_H, COL_RADAR_OUT);
  spr.fillCircle(RADAR_CX, RADAR_CY, RADAR_R, COL_RADAR_IN);
  float step = ringStep(settings.range_nm), s = radarScale();
  useFont(font16);
  spr.setTextColor(COL_RING_TEXT);
  spr.setTextDatum(BL_DATUM);
  for (float r = step; r <= settings.range_nm + 0.01f; r += step) {
    int pr = lroundf(r * s);
    spr.drawCircle(RADAR_CX, RADAR_CY, pr, COL_RING);
    // Label on the ring at 45 degrees (NE), clear of the cardinal letters.
    int lx = RADAR_CX + lroundf(pr * 0.7071f) + 3, ly = RADAR_CY - lroundf(pr * 0.7071f) - 2;
    spr.drawString(ringLabel(r) + (r + step > settings.range_nm + 0.01f ? " nm" : ""), lx, ly);
  }
  spr.drawFastHLine(RADAR_CX - RADAR_R, RADAR_CY, RADAR_R * 2, COL_RING);
  spr.drawFastVLine(RADAR_CX, RADAR_CY - RADAR_R, RADAR_R * 2, COL_RING);
  spr.setTextDatum(MC_DATUM);
  spr.setTextColor(COL_ACCENT);
  spr.drawString("N", RADAR_CX, RADAR_CY - RADAR_R + 12);

  if ((settings.show_card || (settings.alert && CrowPanel7::hasBuzzer())) &&
      overheadNm() < settings.range_nm) {
    int ar = lroundf(overheadNm() * s);
    uint16_t col = rgb888to565(90, 30, 34);
    for (int a = 0; a < 360; a += 10) {   // dashed
      float a0 = a * DEG, a1 = (a + 5) * DEG;
      spr.drawLine(RADAR_CX + ar * sinf(a0), RADAR_CY - ar * cosf(a0),
                   RADAR_CX + ar * sinf(a1), RADAR_CY - ar * cosf(a1), col);
    }
  }

  // Home
  spr.fillCircle(RADAR_CX, RADAR_CY, 5, COL_HOME);
  spr.drawCircle(RADAR_CX, RADAR_CY, 8, COL_HOME);
}

void drawTrail(const Aircraft& a, float nowX, float nowY) {
  Trail* t = findTrail(a.hex);
  if (!t || t->n == 0) return;
  uint16_t col = altColor(a.alt, 0.55f);
  float px = 0, py = 0;
  bool havePrev = false;
  for (int k = 0; k < t->n; k++) {
    int idx = (t->head + TRAIL_POINTS - t->n + k) % TRAIL_POINTS;
    float x, y;
    project(t->lat[idx], t->lon[idx], x, y);
    bool in = insideRadar(x, y);
    if (havePrev && in) spr.drawLine(px, py, x, y, col);
    px = x; py = y; havePrev = in;
  }
  if (havePrev) spr.drawLine(px, py, nowX, nowY, col);
}

#define LABEL_H 36

int labelWidth(const Aircraft& a) {
  useFont(font16);
  return max(spr.textWidth(aircraftName(a)), spr.textWidth(altString(a.alt)) + (abs(a.rate) >= 300 ? 12 : 0));
}

// Label at (lx, ly) top-left: name, then altitude with a climb / descent arrow.
void drawLabel(const Aircraft& a, int lx, int ly, int w, bool selected) {
  useFont(font16);
  if (selected) spr.fillRoundRect(lx - 4, ly - 2, w + 8, LABEL_H + 2, 4, rgb888to565(40, 60, 80));
  spr.setTextDatum(TL_DATUM);
  spr.setTextColor(TFT_WHITE);
  spr.drawString(aircraftName(a), lx, ly);
  uint16_t col = altColor(a.alt);
  spr.setTextColor(col);
  int aw = spr.drawString(altString(a.alt), lx, ly + 18);
  if (abs(a.rate) >= 300) {
    int ax = lx + aw + 6, ay = ly + 26;
    if (a.rate > 0) spr.fillTriangle(ax - 4, ay + 3, ax + 4, ay + 3, ax, ay - 4, col);
    else            spr.fillTriangle(ax - 4, ay - 3, ax + 4, ay - 3, ax, ay + 4, col);
  }
}

struct LabelBox { int16_t x, y, w; int16_t index; };

bool labelFree(const LabelBox* boxes, int n, int x, int y, int w) {
  for (int i = 0; i < n; i++) {
    const LabelBox& o = boxes[i];
    if (x < o.x + o.w + 6 && o.x < x + w + 6 && y < o.y + LABEL_H && o.y < y + LABEL_H) return false;
  }
  return true;
}

void drawAircraft(uint32_t now) {
  static float px[MAX_AIRCRAFT], py[MAX_AIRCRAFT];
  static bool  shown[MAX_AIRCRAFT];
  static LabelBox boxes[MAX_AIRCRAFT];
  hitCount = 0;
  int selIdx = selHex[0] ? findAircraft(selHex) : -1;

  for (int i = 0; i < viewCount; i++) {
    double lat, lon;
    extrapolate(viewAc[i], now, lat, lon);
    project(lat, lon, px[i], py[i]);
    shown[i] = insideRadar(px[i], py[i], 4);
  }

  // Labels are placed nearest first (selected before all), right of the icon
  // or else left of it, and skipped where they would overlap one already placed.
  int nBoxes = 0;
  for (int k = -1; k < viewCount; k++) {
    int i = k < 0 ? selIdx : k;
    if (i < 0 || !shown[i] || (k >= 0 && i == selIdx)) continue;
    const Aircraft& a = viewAc[i];
    if (i != selIdx && (!settings.labels || a.alt == ALT_GROUND)) continue;
    int w = labelWidth(a);
    int ly = constrain((int)py[i] - 18, 2, SCREEN_H - LABEL_H - 2);
    int rx = px[i] + 16, lx = px[i] - 16 - w;
    bool rightOk = rx + w < PANEL_X - 4, leftOk = lx >= 2;
    int x = -1;
    if (i == selIdx)                                                 x = rightOk ? rx : lx;
    else if (rightOk && labelFree(boxes, nBoxes, rx, ly, w))         x = rx;
    else if (leftOk  && labelFree(boxes, nBoxes, lx, ly, w))         x = lx;
    if (x >= 0) boxes[nBoxes++] = {(int16_t)x, (int16_t)ly, (int16_t)w, (int16_t)i};
  }

  // Trails and icons far to near, so the nearest end up on top; selected last.
  for (int pass = 0; pass < 2; pass++) {
    for (int i = viewCount - 1; i >= 0; i--) {
      if (!shown[i] || (pass == 1) != (i == selIdx)) continue;
      const Aircraft& a = viewAc[i];
      float x = px[i], y = py[i];
      if (settings.trails) drawTrail(a, x, y);
      uint16_t col = altColor(a.alt);
      if (inOverhead(a)) {
        spr.drawCircle(x, y, 17, COL_ALERT);
        spr.drawCircle(x, y, 18, COL_ALERT);
      }
      if (i == selIdx) spr.drawCircle(x, y, 20, TFT_WHITE);
      if (a.alt == ALT_GROUND)      spr.fillCircle(x, y, 3, col);
      else if (a.cat[0] == 'A' && a.cat[1] == '7') {   // rotorcraft
        spr.fillCircle(x, y, 5, col);
        spr.drawLine(x - 9, y - 9, x + 9, y + 9, col);
        spr.drawLine(x - 9, y + 9, x + 9, y - 9, col);
      }
      else if (a.track < 0)         spr.fillCircle(x, y, 6, col);
      else                          drawPlane(x, y, a.track, planeSize(a), col);
      if (hitCount < MAX_AIRCRAFT) hits[hitCount++] = {(int16_t)x, (int16_t)y, (int16_t)i};
    }
  }
  // Labels on top of every icon; the selected one (placed first) drawn last.
  for (int b = nBoxes - 1; b >= 0; b--) {
    const LabelBox& l = boxes[b];
    drawLabel(viewAc[l.index], l.x, l.y, l.w, l.index == selIdx);
  }
}

void drawNoHome() {
