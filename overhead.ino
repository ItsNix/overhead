void drawList(uint32_t now) {
  listCount = 0;
  int x0 = PANEL_X + 8, w = PANEL_W - 16;
  if (!homeSet()) return;
  if (viewCount == 0) {
    useFont(font20);
    spr.setTextDatum(MC_DATUM);
    spr.setTextColor(COL_DIM_TEXT);
    spr.drawString(feed.okAt ? "No aircraft in range" : "Waiting for data...",
                   PANEL_X + PANEL_W / 2, LIST_Y + 100);
    return;
  }
  // Airborne aircraft first, nearest first; then any on the ground.
  for (int k = 0; k < viewCount * 2 && listCount < LIST_ROWS; k++) {
    int i = k % viewCount;
    if ((viewAc[i].alt == ALT_GROUND) != (k >= viewCount)) continue;
    const Aircraft& a = viewAc[i];
    int y = LIST_Y + listCount * LIST_ROW_H;
    listIndex[listCount++] = i;
    double lat, lon;
    extrapolate(a, now, lat, lon);
    float d = distanceNm(settings.home_lat, settings.home_lon, lat, lon);
    float b = bearingDeg(settings.home_lat, settings.home_lon, lat, lon);

    spr.fillRoundRect(x0, y, w, LIST_ROW_H - 6, 6, COL_ROW);
    spr.fillRoundRect(x0, y, 6, LIST_ROW_H - 6, 3, altColor(a.alt));
    spr.setTextDatum(TL_DATUM);
    useFont(font24);
    spr.setTextColor(TFT_WHITE);
    spr.drawString(aircraftName(a), x0 + 16, y + 3);
    spr.setTextDatum(TR_DATUM);
    useFont(font20);
    spr.setTextColor(COL_DIM_TEXT);
    spr.drawString(a.type[0] ? a.type : a.cat, x0 + w - 10, y + 5);
    spr.setTextDatum(TL_DATUM);
    useFont(font16);
    spr.setTextColor(altColor(a.alt));
    int ax = x0 + 16 + spr.drawString(altString(a.alt), x0 + 16, y + 30);
    spr.setTextColor(COL_DIM_TEXT);
    String rest = (a.gs >= 0 ? "  " + String(a.gs) + " kt" : String("")) + "  " + nmString(d) +
                  " nm " + compass8(b);
    spr.drawString(rest, ax, y + 30);
  }
}

